# ============================================================================
# KONFIGURASI WAJIB — didapat dari 1 magic link asli (lihat README Bab 2)
# Jalankan: node tools/extract-magic-link.mjs "<tempel magic link>"
# ============================================================================

# Firebase Web API Key proyek Alight Motion (format: AIza...)
AM_FIREBASE_API_KEY=

# Continue URL persis seperti di magic link resmi (wajib sama, kalau salah
# Firebase menolak / email berisi link yang tidak cocok)
AM_CONTINUE_URL=

# Paket Android resmi (default sudah benar, jarang perlu diubah)
AM_ANDROID_PACKAGE=com.alightcreative.motion

# Referer wajib: API key Firebase Alight Motion dibatasi HTTP referrer.
# Tanpa header ini Firebase menolak (API_KEY_HTTP_REFERRER_BLOCKED).
# Nilai yang terbukti lolos: https://alight-creative.firebaseapp.com/
AM_REFERER=https://alight-creative.firebaseapp.com/

# Opsional: tampilkan idToken/refreshToken Firebase di respons verify (default: false)
# Nyalakan (true) hanya untuk debugging — token = akses penuh ke akun user!
AM_RETURN_TOKENS=false
